# Normalize line endings: text files as LF in the repo, native on checkout.
* text=auto

# Files that must always be LF, even on Windows checkouts.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# index.html carries a CSP-hashed inline script; identical bytes on every
# platform keep the hash valid.
*.html text eol=lf

# Binary files.
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.woff2 binary
